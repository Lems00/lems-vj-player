{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pages-localhost",
  "description": "Pages servies en http://localhost : fenêtre principale sur Mac (YouTube l'exige), variante B de l'essai 1. Mêmes commandes que la fenêtre principale.",
  "windows": [
    "main",
    "sortie",
    "http-*"
  ],
  "remote": {
    "urls": [
      "http://localhost:14870/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-platform-info",
    "allow-audio-devices",
    "allow-audio-inventory",
    "allow-audio-start",
    "allow-audio-stats",
    "allow-audio-stop",
    "allow-console-start",
    "allow-console-info",
    "allow-console-new-code",
    "allow-console-broadcast",
    "allow-console-messages",
    "allow-discover",
    "allow-device-connect",
    "allow-device-status",
    "allow-device-messages",
    "allow-device-send",
    "allow-now-ms",
    "allow-list-monitors",
    "allow-open-output",
    "allow-close-output",
    "allow-open-http-page"
  ]
}
